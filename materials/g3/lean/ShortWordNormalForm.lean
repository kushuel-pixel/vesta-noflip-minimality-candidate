import ShortWordMatrix

/-! Target-specific uniqueness for alternating factor words.
The proof uses the nonnegative monoid generated by A and L; no faithfulness
or free-product presentation theorem is postulated. -/
namespace Candidate.ShortWordNormalForm
open Candidate.ShortWordDelete Candidate.ShortWordRecovery Candidate.ShortWordMatrix

def family : Factor → Bool
  | .sigma => false | _ => true

def Alternating : List Factor → Prop
  | [] => True
  | [_] => True
  | a :: b :: w => family a ≠ family b ∧ Alternating (b :: w)

theorem alternating_tail {a : Factor} {w : List Factor} (h : Alternating (a :: w)) :
    Alternating w := by
  cases w with
  | nil => trivial
  | cons b w => exact h.2

def StartsSigma (w : List Factor) : Prop := ∀ a t, w = a :: t → a = .sigma

theorem rho_tail_starts {a : Factor} {w : List Factor}
    (ha : family a = true) (h : Alternating (a :: w)) : StartsSigma w := by
  intro b t he
  subst w
  have hb := h.1
  rw [ha] at hb
  cases b <;> simp_all [family]

def rhoFactor (b : Bool) : Factor := if b then .rhoInv else .rho

def coreWord : List Bool → Bool → List Factor
  | [], t => if t then [.sigma] else []
  | b :: bs, t => .sigma :: rhoFactor b :: coreWord bs t

def leadWord : Option Bool → List Factor
  | none => []
  | some b => [rhoFactor b]

theorem core_shape (w : List Factor) (ha : Alternating w) (hs : StartsSigma w) :
    ∃ bs t, w = coreWord bs t := by
  cases w with
  | nil => exact ⟨[], false, rfl⟩
  | cons a w =>
    have he := hs a w rfl
    subst a
    cases w with
    | nil => exact ⟨[], true, rfl⟩
    | cons b rest =>
      have hb := ha.1
      have ht := ha.2
      cases b with
      | sigma => exact False.elim (hb rfl)
      | rho =>
        obtain ⟨bs,t,he⟩ := core_shape rest (alternating_tail ht)
          (rho_tail_starts rfl ht)
        exact ⟨false :: bs, t, by simp only [coreWord, rhoFactor, Bool.false_eq_true,
          ↓reduceIte, he]⟩
      | rhoInv =>
        obtain ⟨bs,t,he⟩ := core_shape rest (alternating_tail ht)
          (rho_tail_starts rfl ht)
        exact ⟨true :: bs, t, by simp only [coreWord, rhoFactor, ↓reduceIte, he]⟩
termination_by w.length

theorem alternating_shape (w : List Factor) (ha : Alternating w) :
    ∃ p bs t, w = leadWord p ++ coreWord bs t := by
  cases w with
  | nil => exact ⟨none, [], false, rfl⟩
  | cons a w =>
    cases a with
    | sigma =>
      obtain ⟨bs,t,he⟩ := core_shape (.sigma :: w) ha (by
        intro a u h; cases h; rfl)
      exact ⟨none,bs,t,he⟩
    | rho =>
      obtain ⟨bs,t,he⟩ := core_shape w (alternating_tail ha) (rho_tail_starts rfl ha)
      exact ⟨some false,bs,t,by simp [leadWord,rhoFactor,he]⟩
    | rhoInv =>
      obtain ⟨bs,t,he⟩ := core_shape w (alternating_tail ha) (rho_tail_starts rfl ha)
      exact ⟨some true,bs,t,by simp [leadWord,rhoFactor,he]⟩

def positiveMat : List Bool → Mat
  | [] => 1
  | b :: bs => (if b then L else A) * positiveMat bs

def tailMat (t : Bool) : Mat := if t then S else 1

def prefixMat : Option Bool → Mat
  | none => 1
  | some b => if b then Ri else R

theorem core_signed (bs : List Bool) (t : Bool) :
    SignedEq (eval (coreWord bs t)) (positiveMat bs * tailMat t) := by
  induction bs with
  | nil => cases t <;> simp [coreWord, eval, factorMat, positiveMat, tailMat, SignedEq]
  | cons b bs ih =>
    cases b
    · simpa only [coreWord, rhoFactor, Bool.false_eq_true, ↓reduceIte,
        eval_cons, factorMat, ← mul_assoc, pair_a, positiveMat] using
        (SignedEq.refl A).mul ih
    · have hp : SignedEq (S * Ri) L := Or.inr pair_l
      simpa only [coreWord, rhoFactor, ↓reduceIte, eval_cons, factorMat,
        ← mul_assoc, positiveMat] using hp.mul ih

theorem shape_signed (p : Option Bool) (bs : List Bool) (t : Bool) :
    SignedEq (eval (leadWord p ++ coreWord bs t))
      (prefixMat p * positiveMat bs * tailMat t) := by
  have he : eval (leadWord p) = prefixMat p := by
    cases p with
    | none => rfl
    | some b => cases b <;> simp [leadWord, rhoFactor, eval, factorMat, prefixMat]
  rw [eval_append, he, mul_assoc]
  exact (SignedEq.refl _).mul (core_signed bs t)

def Positive (m : Mat) : Prop :=
  1 ≤ m 0 0 ∧ 0 ≤ m 0 1 ∧ 0 ≤ m 1 0 ∧ 1 ≤ m 1 1

theorem positive_entries (bs : List Bool) : Positive (positiveMat bs) := by
  induction bs with
  | nil => norm_num [Positive, positiveMat]
  | cons b bs ih =>
    rcases ih with ⟨ha,hb,hc,hd⟩
    cases b <;> simp [Positive, positiveMat, A, L, Matrix.mul_apply,
      Fin.sum_univ_two] <;> omega

theorem positive_zero_lower (bs : List Bool) (hz : positiveMat bs 1 0 = 0) :
    bs = List.replicate bs.length false := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    have hp := positive_entries bs
    cases b
    · have hz' : positiveMat bs 1 0 = 0 := by
        simpa [positiveMat, A, Matrix.mul_apply, Fin.sum_univ_two] using hz
      simpa only [List.length_cons, List.replicate_succ] using congrArg (List.cons false) (ih hz')
    · have he : positiveMat bs 0 0 + positiveMat bs 1 0 = 0 := by
        simpa [positiveMat, L, Matrix.mul_apply, Fin.sum_univ_two] using hz
      dsimp [Positive] at hp
      omega

theorem positive_replicate (k : ℕ) : positiveMat (List.replicate k false) = U k := by
  induction k with
  | zero => ext i j; fin_cases i <;> fin_cases j <;> norm_num [positiveMat, U]
  | succ k ih =>
    simp only [List.replicate_succ, positiveMat, Bool.false_eq_true, ↓reduceIte, ih]
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [A, U, Matrix.mul_apply, Fin.sum_univ_two]

theorem positive_shape_target {m : Mat} {n : ℕ} (hm : Positive m)
    (p : Option Bool) (t : Bool)
    (h : SignedEq (prefixMat p * m * tailMat t) (H n)) :
    p = none ∧ t = true ∧ m = U n := by
  obtain ⟨ha,hb,hc,hd⟩ := hm
  cases p with
  | none =>
    cases t
    · rcases h with h | h <;>
        have e01 := congrArg (fun z : Mat => z 0 1) h <;>
        have e10 := congrArg (fun z : Mat => z 1 0) h <;>
        simp [prefixMat, tailMat, H] at e01 e10 <;> omega
    · rcases h with h | h
      · refine ⟨rfl,rfl,?_⟩
        have e00 := congrArg (fun z : Mat => z 0 0) h
        have e01 := congrArg (fun z : Mat => z 0 1) h
        have e10 := congrArg (fun z : Mat => z 1 0) h
        have e11 := congrArg (fun z : Mat => z 1 1) h
        simp [prefixMat, tailMat, H, S, Matrix.mul_apply, Fin.sum_univ_two] at e00 e01 e10 e11
        ext i j; fin_cases i <;> fin_cases j <;> simp [U] <;> omega
      · have e01 := congrArg (fun z : Mat => z 0 1) h
        simp [prefixMat, tailMat, H, S, Matrix.mul_apply, Fin.sum_univ_two] at e01
        omega
  | some b =>
    cases b <;> cases t <;> rcases h with h | h <;>
      have e00 := congrArg (fun z : Mat => z 0 0) h <;>
      have e01 := congrArg (fun z : Mat => z 0 1) h <;>
      have e10 := congrArg (fun z : Mat => z 1 0) h <;>
      have e11 := congrArg (fun z : Mat => z 1 1) h <;>
      simp [prefixMat, tailMat, R, Ri, S, H, Matrix.mul_apply,
        Fin.sum_univ_two, Matrix.vecMul, dotProduct] at e00 e01 e10 e11 <;> omega

theorem core_replicate_terminal (n : ℕ) :
    coreWord (List.replicate n false) true = terminal n := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ, coreWord, rhoFactor, terminal, ih]

theorem alternating_terminal_unique {w : List Factor} {n : ℕ}
    (ha : Alternating w) (he : SignedEq (eval w) (H n)) : w = terminal n := by
  obtain ⟨p,bs,t,hw⟩ := alternating_shape w ha
  have hm := (shape_signed p bs t).symm.trans (hw ▸ he)
  obtain ⟨hp,ht,hmat⟩ := positive_shape_target (positive_entries bs) p t hm
  subst p; subst t
  have hz : positiveMat bs 1 0 = 0 := by rw [hmat]; rfl
  have hb := positive_zero_lower bs hz
  have hk : bs.length = n := by
    rw [hb, positive_replicate] at hmat
    have hk := congrArg (fun z : Mat => z 0 1) hmat
    simpa [U] using hk
  rw [hw, leadWord, List.nil_append, hb, hk, core_replicate_terminal]

end Candidate.ShortWordNormalForm
